# OpenWear extension — PUBLIC configuration only. Copy to .env.development
# (and .env.production for store builds) and fill in real values there.
# NEVER put CLERK_SECRET_KEY, DECART_API_KEY, or AGENT_SERVICE_KEY in this
# extension or any of its env files. Real values live only in local,
# gitignored .env.* files — never commit them.

# Clerk publishable key for the Chrome Extension instance.
# Dashboard → API keys → Quick Copy → select "Chrome Extension".
PLASMO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Sync Host value for Clerk session sync (NOT the user-facing web app URL).
# Development per Clerk docs: http://localhost
# Production: your Clerk Frontend API host.
PLASMO_PUBLIC_CLERK_SYNC_HOST=http://localhost

# User-facing Fitcheck web app origin, used for links such as sign-in.
# Development: http://localhost:3000. Production: the deployed SaaS domain.
PLASMO_PUBLIC_FITCHECK_APP_URL=http://localhost:3000

# Convex deployment URL (same deployment the web app uses).
PLASMO_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Stable extension ID for Sync Host + Clerk allowed_origins.
# Generate once via the Plasmo Itero keypair tool, keep the PRIVATE key secret,
# and put the PUBLIC key in .env.chrome as CRX_PUBLIC_KEY (see docs/EXTENSION_AUTH_SETUP.md).
# CRX_PUBLIC_KEY=
