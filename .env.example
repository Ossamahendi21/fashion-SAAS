# --- Next.js (copy to .env.local) ---
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/wardrobe
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- eve stylist agent (read by the eve dev server from the same .env.local) ---
# Build-time Eve root selection (next.config.ts): unset or "legacy" serves the repo-root agent/
# ("openai/gpt-5.4-mini" via the Vercel AI Gateway); "deterministic" serves agent-deterministic/
# (zero-provider stylist_turn transport). Any other value fails the build.
# FITCHECK_EVE_ROOT=legacy
# Step 7 Phase C9.1 — deterministic render capability. Fail-closed: ONLY the exact value "true"
# enables quoting/approving/executing renders; unset, empty, "false", typos all DISABLE it.
# First deterministic production release: leave unset (or false). Do NOT set "true" until Step 5
# ships a safe approved renderer. Server-only: never NEXT_PUBLIC_, never readable from the client.
# STYLIST_RENDER_ENABLED=false
# Model routing for agent/agent.ts ("openai/gpt-5.4-mini" via the Vercel AI Gateway).
AI_GATEWAY_API_KEY=            # or link the Vercel project and use OIDC (VERCEL_OIDC_TOKEN)
AGENT_SERVICE_KEY=            # generate one: openssl rand -hex 32 — must equal the Convex AGENT_SERVICE_KEY below
# The agent tools also read NEXT_PUBLIC_CONVEX_URL (above) for the Convex HTTP client and
# CLERK_SECRET_KEY (above) to verify the browser's bearer token in agent/channels/eve.ts.
# Optional: in `eve dev` there is no Clerk session, so point the synthetic local principal at a
# real Clerk user id or every agent tool will fail with NOT_FOUND.
# Optional: restricts which origin's Clerk tokens the stylist channel accepts (Clerk `authorizedParties`); unset in local dev.
# SITE_URL=https://fitcheck.app
AGENT_DEV_CLERK_USER_ID=
# Optional: only needed when the built eve service is served from another origin or port
# (`next build && next start`); withEve defaults to http://127.0.0.1:4274.
# EVE_NEXT_PRODUCTION_ORIGIN=
# EVE_NEXT_PRODUCTION_PORT=4274

# --- Convex (set with `npx convex env set NAME value`, not in this file) ---
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_test_...  # same Clerk instance as the app; reads current Billing subscriptions
# OPENAI_API_KEY=sk-...        # direct OpenAI, or AI_GATEWAY_API_KEY for all AI calls
# AI_GATEWAY_API_KEY=          # same Gateway key as the stylist
# AGENT_SERVICE_KEY=            # same value as above
# SITE_URL=http://localhost:3000 # app origin serving the demo wardrobe images
# MAX_DAILY_SPEND_USD=50
# DECART_API_KEY=            # server-only permanent Decart key for Live Mirror token minting (Convex deployment only; never NEXT_PUBLIC_, never in extension code)
# LIVE_MIRROR_SESSION_MAX_SECONDS=300  # per-session Live Mirror safety cap in seconds (1-3600); missing/invalid fails closed
# EXTRACTION_PROVIDER=original  # zero-provider default preserves the uploaded image; "florencesam" enables the self-hosted cutout service, while "openai" remains legacy-only.
# WITHOUTBG_BASE_URL=https://withoutbg-api.duckdns.org  # server-only self-hosted withoutBG gateway origin (never NEXT_PUBLIC_)
# WITHOUTBG_API_KEY=          # server-only private key the self-hosted gateway expects in X-API-Key (never NEXT_PUBLIC_, never logged)
# WITHOUTBG_COST_USD_PER_IMAGE=0.001  # operator-estimated self-host cost per extraction, recorded as COGS; 0 if free/infra-internal
# FLORENCESAM_BASE_URL=https://your-florencesam-gateway  # server-only self-hosted Florence+SAM2 gateway origin (never NEXT_PUBLIC_; external spend is $0 by contract)
# FLORENCESAM_API_KEY=          # server-only private key the Florence+SAM2 gateway expects in X-API-Key (never NEXT_PUBLIC_, never logged)
# RENDER_PROVIDER=openai  # try-on render provider: "openai" (default, gpt-image-2). Server-only; do not set yet.
# --- Step 7: local BGE embeddings (BAAI/bge-small-en-v1.5, 384 dims, $0 provider cost) ---
# Migration window (new BGE writes, legacy reads — existing similarity unchanged):
# EMBEDDING_PROVIDER=local
# EMBEDDING_READ_GENERATION=legacy
# After backfill coverage + shadow validation, cut readers over explicitly:
# EMBEDDING_PROVIDER=local
# EMBEDDING_READ_GENERATION=bge
# At no point is explicit openai required. EMBEDDING_PROVIDER has NO default (missing/empty fails
# closed); EMBEDDING_READ_GENERATION defaults to legacy (stored vectors only — it cannot bill anything).
# EMBEDDING_PROVIDER=local  # "local" = self-hosted BGE writes; "openai" = legacy reference/rollback only. Server-only. There is NO automatic fallback: a local failure never retries on OpenAI.
# EMBEDDING_READ_GENERATION=legacy  # "legacy" = read stored OpenAI vectors (by_embedding); "bge" = read local BGE vectors (by_embeddingBge). Server-only; stored vectors only, never a network call.
# EMBEDDING_BASE_URL=https://your-bge-gateway  # server-only self-hosted BGE gateway origin (never NEXT_PUBLIC_)
# EMBEDDING_API_KEY=          # server-only private key the BGE gateway expects in X-API-Key (never NEXT_PUBLIC_, never logged)
# EMBEDDING_BACKFILL_KEY=     # dedicated service key for convex/embeddingBackfill:runBackfill (generate: openssl rand -hex 32). NOT AGENT_SERVICE_KEY.

# --- Optional switches ---
# SKIP_ENV_VALIDATION=1        # skip the t3-env check (CI builds without real keys)
# On the Convex deployment: ALLOW_DEV_SMOKE=1 enables convex/dev/smoke.ts helpers (never in production).
