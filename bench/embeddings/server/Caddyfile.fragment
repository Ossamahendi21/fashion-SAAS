# REQUIRED before production use: Convex actions run in Convex cloud and cannot reach 127.0.0.1 on
# the VPS. Expose the localhost gateway behind TLS by adding ONE vhost to the EXISTING Caddy setup,
# mirroring the florencesam-api / withoutbg-api vhost style already on this box.
# Port 18090 is private: the gateway itself binds 127.0.0.1 only.
# Replace the hostname with the real public origin, then: sudo systemctl reload caddy.
bge-api.duckdns.org {
	reverse_proxy 127.0.0.1:18090
}